# Environment Configuration for Indian Standards Recommender Engine

# LLM Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative fast model on Groq: llama-3.1-8b-instant

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/is_recommender
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=is_recommender
POSTGRES_PORT=5432

# SQLite fallback path if PostgreSQL is offline
SQLITE_DB_PATH=data/standards.db

# Embedding & Search
EMBED_MODEL=BAAI/bge-small-en-v1.5
RRF_K=60
