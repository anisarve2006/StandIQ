# ==============================================================================
# Git Ignore Configuration for Indian Standards Recommender Engine (SIH26108)
# Strict Security Policy: Zero API Keys, Zero Sensitive Data, Zero Raw Databases
# ==============================================================================

# --- Secrets & Environment Variables ---
.env
*.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json
service_account.json

# --- Sensitive Datasets, Database Files & Large Binaries ---
*.gguf
*.db
*.sqlite
*.sqlite3
*.npz
*.parquet
*.tar.gz
*.zip
*.bin
data/
backend/data/*
!backend/data/qco_master.json
!backend/data/sample_gem_tender.pdf

# --- Node / Frontend Artifacts ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local


# --- Python Cache & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# --- Testing, Coverage & Profiling ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.log
scratch/
scratch_*.py

# --- IDE & OS Artifacts ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

# --- Subagent & IDE Brain Logs ---
.system_generated/
.tempmediaStorage/
.user_uploaded/
