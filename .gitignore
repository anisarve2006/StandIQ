# ==============================================================================
# Git Ignore Configuration for Indian Standards Recommender Engine (SIH26108)
# Strict Security Policy: Zero API Keys, Zero Sensitive Data, Zero Raw Databases
# ==============================================================================

# --- Secrets & Environment Variables ---
.env
*.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json
service_account.json

# --- Sensitive Datasets, Database Files & Large Binaries ---
backend/data/standards.db
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
backend/data/*.jsonl
backend/data/*.csv
backend/data/*.xlsx
backend/data/*.xls
backend/data/*.parquet
backend/data/*.tar.gz
backend/data/*.zip
backend/data/*.pdf
!data/qco_master.json
!data/sample_gem_tender.pdf

# --- Python Cache & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# --- Testing, Coverage & Profiling ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.log
scratch/
scratch_*.py

# --- IDE & OS Artifacts ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

# --- Subagent & IDE Brain Logs ---
.system_generated/
.tempmediaStorage/
.user_uploaded/
